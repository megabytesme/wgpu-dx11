+            context.Unmap(&staging, 0);
+            for (y, row) in pixels.iter().enumerate() {
+                for (x, value) in row.iter().enumerate() {
+                    assert_eq!(
+                        *value,
+                        (i * 16 + y * 4 + x + 1) as u32,
+                        "target {i}, ({x},{y})"
+                    );
+                }
+            }
+        }
+    }
+}
+
+unsafe fn depth_view(device: &ID3D11Device) -> ID3D11DepthStencilView {
+    let mut texture = None;
+    let mut view = None;
+    unsafe {
+        device
+            .CreateTexture2D(
+                &D3D11_TEXTURE2D_DESC {
+                    Width: 4,
+                    Height: 4,
+                    MipLevels: 1,
+                    ArraySize: 1,
+                    Format: DXGI_FORMAT_D24_UNORM_S8_UINT,
+                    SampleDesc: DXGI_SAMPLE_DESC {
+                        Count: 1,
+                        Quality: 0,
+                    },
+                    Usage: D3D11_USAGE_DEFAULT,
+                    BindFlags: D3D11_BIND_DEPTH_STENCIL.0 as u32,
+                    ..Default::default()
+                },
+                None,
+                Some(&mut texture),
+            )
+            .unwrap();
+        device
+            .CreateDepthStencilView(texture.as_ref().unwrap(), None, Some(&mut view))
+            .unwrap();
+    }
+    view.unwrap()
+}
+
+unsafe fn new_query(device: &ID3D11Device, kind: D3D11_QUERY) -> ID3D11Asynchronous {
+    let mut query = None;
+    unsafe {
+        device
+            .CreateQuery(
+                &D3D11_QUERY_DESC {
+                    Query: kind,
+                    MiscFlags: 0,
+                },
+                Some(&mut query),
+            )
+            .unwrap();
+    }
+    query.unwrap().cast().unwrap()
+}
+
+unsafe fn buffer(
+    device: &ID3D11Device,
+    size: u32,
+    usage: D3D11_USAGE,
+    bind: u32,
+    cpu_access: u32,
+) -> ID3D11Buffer {
+    let mut buffer = None;
+    unsafe {
+        device
+            .CreateBuffer(
+                &D3D11_BUFFER_DESC {
+                    ByteWidth: size,
+                    Usage: usage,
+                    BindFlags: bind,
+                    CPUAccessFlags: cpu_access,
+                    ..Default::default()
+                },
+                None,
+                Some(&mut buffer),
+            )
+            .unwrap()
+    };
+    buffer.unwrap()
+}
+
+unsafe fn target(device: &ID3D11Device, staging: bool) -> ID3D11Texture2D {
+    let mut texture = None;
+    let mut desc = D3D11_TEXTURE2D_DESC {
+        Width: 4,
+        Height: 4,
+        MipLevels: 1,
+        ArraySize: 1,
+        Format: DXGI_FORMAT_R32_UINT,
+        SampleDesc: DXGI_SAMPLE_DESC {
+            Count: 1,
+            Quality: 0,
+        },
+        Usage: D3D11_USAGE_DEFAULT,
+        BindFlags: D3D11_BIND_RENDER_TARGET.0 as u32,
+        ..Default::default()
+    };
+    if staging {
+        desc.Usage = D3D11_USAGE_STAGING;
+        desc.BindFlags = 0;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ.0 as u32;
+    }
+    unsafe {
+        device
+            .CreateTexture2D(&desc, None, Some(&mut texture))
+            .unwrap()
+    };
+    texture.unwrap()
+}
+
+unsafe fn query_data<T: Default>(
+    device: &ID3D11Device,
+    context: &ID3D11DeviceContext,
+    query: &ID3D11Asynchronous,
+) -> T {
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let mut data = T::default();
+    loop {
+        let result = unsafe {
+            (context.vtable().GetData)(
+                context.as_raw(),
+                query.as_raw(),
+                (&mut data as *mut T).cast(),
+                size_of::<T>() as u32,
+                D3D11_ASYNC_GETDATA_DONOTFLUSH.0 as u32,
+            )
+        };
+        if result == S_OK {
+            return data;
+        }
+        assert_eq!(result, S_FALSE, "native query failed");
+        unsafe { device.GetDeviceRemovedReason().unwrap() };
+        assert!(Instant::now() < deadline, "native query timed out");
+        std::thread::yield_now();
+    }
+}
