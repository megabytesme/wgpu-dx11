fails-if(dx11) webgpu:shader,execution,expression,call,builtin,firstLeadingBit:*
//FAIL: webgpu:shader,execution,expression,call,builtin,select:*
// - Fails with `const`/abstract int cases on all platforms because of <https://github.com/gfx-rs/wgpu/issues/4507>.
// - Fails with `vec3` & `f16` cases on macOS because of <https://github.com/gfx-rs/wgpu/issues/5262>.
// This matrix returns raw u32 dimensions across vertex/compute and texture
// dimensions outside FL9_1. The narrow fragment float-conversion path is
// covered by the strict public DX11 tests.
fails-if(dx11,dx12) webgpu:shader,execution,expression,call,builtin,textureDimensions:*
// Execution cases require 36-layer 2D arrays, cube arrays, or storage arrays;
// none are exposed by the FL9_1 projection.
fails-if(dx11) webgpu:shader,execution,expression,call,builtin,textureNumLayers:*
// This CTS matrix returns raw u32 counts through vertex, fragment, and
// compute paths and includes texture dimensions unavailable at FL9_1. The
// narrow fragment float-conversion paths have strict public coverage.
fails-if(dx11) webgpu:shader,execution,expression,call,builtin,textureNumLevels:*
// FL9_1 multisampled textures are restricted to render-attachment and
// transient-attachment usage; this execution fixture also samples them.
fails-if(dx11,dx12) webgpu:shader,execution,expression,call,builtin,textureNumSamples:*
// FL9_1 does not expose 1D textures. This CTS selector also uses a shared
// mip-weight probe with general explicit LOD, which is outside this contract.
fails-if(dx11) webgpu:shader,execution,expression,call,builtin,textureSample:sampled_1d_coords:*
// This compute selector requires compute shaders and the shared execution
// helper's RGBA32Uint render-target/readback path, neither exposed at FL9_1.
fails-if(dx11) webgpu:shader,execution,expression,call,builtin,textureSampleBaseClampToEdge:2d_coords:stage="c";textureType="texture_2d<f32>";*
// NOTE: This is supposed to be an exhaustive listing underneath
// `webgpu:shader,execution,expression,call,builtin,workgroupUniformLoad:*`, so exceptions can be
// worked around.
fails-if(dx11) webgpu:shader,execution,expression,call,builtin,workgroupUniformLoad:types:type="array%3Cu32,%204%3E";*
fails-if(dx11) webgpu:shader,execution,expression,call,builtin,workgroupUniformLoad:types:type="atomic%3Ci32%3E";*
fails-if(dx11) webgpu:shader,execution,expression,call,builtin,workgroupUniformLoad:types:type="atomic%3Cu32%3E";*
fails-if(dx11) webgpu:shader,execution,expression,call,builtin,workgroupUniformLoad:types:type="AtomicInStruct";*
fails-if(dx11) webgpu:shader,execution,expression,call,builtin,workgroupUniformLoad:types:type="bool";*
//FAIL: https://github.com/gfx-rs/wgpu/issues/8812
// webgpu:shader,execution,expression,call,builtin,workgroupUniformLoad:types:type="ComplexStruct";*
fails-if(dx11) webgpu:shader,execution,expression,call,builtin,workgroupUniformLoad:types:type="mat3x2f";*
fails-if(dx11) webgpu:shader,execution,expression,call,builtin,workgroupUniformLoad:types:type="SimpleStruct";*
fails-if(dx11) webgpu:shader,execution,expression,call,builtin,workgroupUniformLoad:types:type="u32";*
fails-if(dx11) webgpu:shader,execution,expression,call,builtin,workgroupUniformLoad:types:type="vec4u";*
fails-if(dx11) webgpu:shader,execution,expression,unary,bool_conversion:*
// The flow-control harness emits only compute entry points, unavailable at FL9_1.
fails-if(dx11) webgpu:shader,execution,flow_control,return:*
// Many other vertex_buffer_access subtests also passing, but there are too many to enumerate.
// Fails on Metal in CI only, not when running locally.
// Fails on Vulkan with LVP_POISON_MEMORY=true possibly due to https://github.com/gfx-rs/wgpu/issues/8034
// This exact shader uses runtime u32 vertex_index comparisons, unavailable at FL9_1.
fails-if(dx11,metal,vulkan) webgpu:shader,execution,robust_access_vertex:vertex_buffer_access:indexed=true;indirect=false;drawCallTestParameter="baseVertex";type="float32x4";additionalBuffers=4;partialLastNumber=false;offsetVertexBuffer=true
// These helpers read back four color attachments, above FL9_1's one-target limit.
// Their sampleCount=4 cases also require unsupported multisampled shading/readback usages.
fails-if(dx11) webgpu:shader,execution,shader_io,fragment_builtins:inputs,front_facing:*
fails-if(dx11) webgpu:shader,execution,shader_io,fragment_builtins:inputs,interStage,centroid:*
fails-if(dx11,vulkan) webgpu:shader,execution,shader_io,fragment_builtins:inputs,interStage:*
fails-if(dx11,dx12,vulkan) webgpu:shader,execution,shader_io,fragment_builtins:inputs,position:*
fails-if(dx11) webgpu:shader,execution,shader_io,fragment_builtins:inputs,sample_index:*
fails-if(dx11,dx12,vulkan) webgpu:shader,execution,shader_io,fragment_builtins:inputs,sample_mask:*
